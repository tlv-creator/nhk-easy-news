{"tag": "ep006", "audio": "/workspace/shun-web/audio/a0a7fc8a-5604-4e9d-81b1-6a59ae7f5a41.mp3", "duration": 527, "sentences": [{"s": 0.0, "e": 3.9, "ja": "しゅん と 日本 語 ポッドキャスト 6", "zh": "Shun的日语播客6。", "frame": [{"s": "しゅん と 日本 語 ポッドキャスト 6", "b": "［］", "role": "标题"}]}, {"s": 3.9, "e": 9.7, "ja": "初心者 Beginners Genki 1 Level", "zh": "初学者 Beginners Genki 1 水平。", "frame": [{"s": "初心者 Beginners Genki 1 Level", "b": "［］", "role": "说明"}]}, {"s": 9.7, "e": 13.9, "ja": "私 の 家族 My Family", "zh": "我的家庭 My Family。", "frame": [{"s": "私 の 家族 My Family", "b": "［］", "role": "主题"}]}, {"s": 13.9, "e": 21.2, "ja": "[音楽]", "zh": "[音乐]", "frame": []}, {"s": 21.2, "e": 25.3, "ja": "どうも こんにちは。日本語教師のしゅんです。", "zh": "大家好。我是日语老师Shun。", "frame": [{"s": "どうも", "b": "[]", "role": "问候"}, {"s": "こんにちは", "b": "[]", "role": "问候"}, {"s": "日本語教師のしゅん", "b": "［］", "role": "主格表语"}, {"s": "です", "b": "（）", "role": "断定谓语"}]}, {"s": 25.3, "e": 28.0, "ja": "皆さん、元気ですか?", "zh": "大家精神好吗？", "frame": [{"s": "皆さん", "b": "［］", "role": "呼语"}, {"s": "元気", "b": "［］", "role": "状态表语"}, {"s": "ですか", "b": "（）", "role": "疑问谓语"}]}, {"s": 28.0, "e": 35.2, "ja": "今日も楽しくポッドキャストを聞いて、日本語の練習をしましょう。", "zh": "今天也开心地听播客，一起练习日语吧。", "frame": [{"s": "今日も", "b": "[]", "role": "时间状语"}, {"s": "楽しく", "b": "[]", "role": "方式状语"}, {"s": "ポッドキャストを", "b": "〈〉", "role": "宾语"}, {"s": "聞いて", "b": "（）", "role": "连用形连接"}, {"s": "日本語の練習を", "b": "〈〉", "role": "宾语"}, {"s": "しましょう", "b": "（）", "role": "劝诱谓语"}]}, {"s": 35.2, "e": 43.7, "ja": "今日は私の家族について紹介しますね。", "zh": "今天我要介绍一下我的家人。", "frame": [{"s": "今日は", "b": "[]", "role": "时间状语"}, {"s": "私の家族について", "b": "［］", "role": "主题对象"}, {"s": "紹介しますね", "b": "（）", "role": "谓语动作"}]}, {"s": 43.7, "e": 50.7, "ja": "皆さん、もう私については知っていますね。", "zh": "大家应该已经了解我了吧。", "frame": [{"s": "皆さん", "b": "［］", "role": "呼语"}, {"s": "もう", "b": "[]", "role": "程度状语"}, {"s": "私については", "b": "［］", "role": "主题状语"}, {"s": "知っていますね", "b": "（）", "role": "持续态谓语"}]}, {"s": 50.7, "e": 62.6, "ja": "私は今、ニュージーランドに住んでいて、italkiでオンラインの日本語の先生をしています。", "zh": "我现在住在新西兰，在italki上做在线日语老师。", "frame": [{"s": "私は", "b": "［］", "role": "主语"}, {"s": "今", "b": "[]", "role": "时间状语"}, {"s": "ニュージーランドに", "b": "［］", "role": "地点状语"}, {"s": "住んでいて", "b": "（）", "role": "连用形连接"}, {"s": "italkiで", "b": "［］", "role": "地点状语"}, {"s": "オンラインの日本語の先生を", "b": "〈〉", "role": "宾语"}, {"s": "しています", "b": "（）", "role": "状态谓语"}]}, {"s": 62.6, "e": 71.9, "ja": "私の家族はみんな、日本の愛知県に住んでいます。", "zh": "我的家人大家都住在日本的爱知县。", "frame": [{"s": "私の家族は", "b": "［］", "role": "主语"}, {"s": "みんな", "b": "[]", "role": "程度副词"}, {"s": "日本の愛知県に", "b": "［］", "role": "地点状语"}, {"s": "住んでいます", "b": "（）", "role": "持续态谓语"}]}, {"s": 71.9, "e": 80.0, "ja": "愛知県は、東京と大阪の間にあります。", "zh": "爱知县位于东京和大阪之间。", "frame": [{"s": "愛知県は", "b": "［］", "role": "主语"}, {"s": "東京と大阪の間に", "b": "［］", "role": "地点状语"}, {"s": "あります", "b": "（）", "role": "存在谓语"}]}, {"s": 80.0, "e": 90.0, "ja": "父と母と弟と妹と私、の5人家族です。", "zh": "父亲、母亲、弟弟、妹妹和我，一共是五口之家。", "frame": [{"s": "父と", "b": "［］", "role": "列举主语"}, {"s": "母と", "b": "［］", "role": "列举主语"}, {"s": "弟と", "b": "［］", "role": "列举主语"}, {"s": "妹と", "b": "［］", "role": "列举主语"}, {"s": "私、の", "b": "［］", "role": "定语修饰"}, {"s": "5人家族", "b": "［］", "role": "名词表语"}, {"s": "です", "b": "（）", "role": "断定谓语"}]}, {"s": 90.0, "e": 94.7, "ja": "まずは私の父です。", "zh": "首先是我的父亲。", "frame": [{"s": "まずは", "b": "[]", "role": "连接副词"}, {"s": "私の父", "b": "［］", "role": "名词表语"}, {"s": "です", "b": "（）", "role": "断定谓语"}]}, {"s": 94.7, "e": 99.5, "ja": "父は歯医者です。歯医者です。", "zh": "父亲是牙医。是牙医。", "frame": [{"s": "父は", "b": "［］", "role": "主语"}, {"s": "歯医者", "b": "［］", "role": "名词表语"}, {"s": "です", "b": "（）", "role": "断定谓语"}, {"s": "歯医者", "b": "［］", "role": "名词表语"}, {"s": "です", "b": "（）", "role": "断定谓语"}]}, {"s": 99.5, "e": 107.7, "ja": "父はとても面白くて真面目な人です。はい、とても真面目ですね。", "zh": "父亲是一个非常有趣且认真的人。是的，非常认真呢。", "frame": [{"s": "父は", "b": "［］", "role": "主语"}, {"s": "とても", "b": "[]", "role": "程度状语"}, {"s": "面白くて", "b": "［］", "role": "连用修饰"}, {"s": "真面目な人", "b": "［］", "role": "名词表语"}, {"s": "です", "b": "（）", "role": "断定谓语"}, {"s": "はい", "b": "[]", "role": "感叹应答"}, {"s": "とても", "b": "[]", "role": "程度状语"}, {"s": "真面目", "b": "［］", "role": "形容表语"}, {"s": "ですね", "b": "（）", "role": "感叹谓语"}]}, {"s": 107.7, "e": 113.6, "ja": "父は勉強するのが大好きです。", "zh": "父亲非常喜欢学习。", "frame": [{"s": "父は", "b": "［］", "role": "主题主语"}, {"s": "勉強するのが", "b": "［］", "role": "对象主语"}, {"s": "大好き", "b": "［］", "role": "形容表语"}, {"s": "です", "b": "（）", "role": "断定谓语"}]}, {"s": 113.6, "e": 124.0, "ja": "最近は、毎日歯や投資の勉強をしています。", "zh": "最近他每天都在学习牙科和投资方面的知识。", "frame": [{"s": "最近は", "b": "[]", "role": "时间状语"}, {"s": "毎日", "b": "[]", "role": "频度状语"}, {"s": "歯や投資の勉強を", "b": "〈〉", "role": "宾语"}, {"s": "しています", "b": "（）", "role": "持续态谓语"}]}, {"s": 124.0, "e": 138.8, "ja": "休みの日は家にいるのが好きで、よく家で家事をしたり、勉強したり、たまにテレビを見たりします。", "zh": "休息日他喜欢待在家里，常常在家里做做家务、学学习、偶尔看看电视。", "frame": [{"s": "休みの日は", "b": "[]", "role": "时间状语"}, {"s": "家にいるのが", "b": "［］", "role": "对象从句"}, {"s": "好きで", "b": "（）", "role": "原因连接"}, {"s": "よく", "b": "[]", "role": "频度状语"}, {"s": "家で", "b": "［］", "role": "地点状语"}, {"s": "家事をしたり", "b": "（）", "role": "列举动作"}, {"s": "勉強したり", "b": "（）", "role": "列举动作"}, {"s": "たまに", "b": "[]", "role": "频度状语"}, {"s": "テレビを", "b": "〈〉", "role": "宾语"}, {"s": "見たりします", "b": "（）", "role": "列举总结"}]}, {"s": 138.8, "e": 143.1, "ja": "父の趣味は剣道です。", "zh": "父亲的爱好是剑道。", "frame": [{"s": "父の趣味は", "b": "［］", "role": "主语"}, {"s": "剣道", "b": "［］", "role": "名词表语"}, {"s": "です", "b": "（）", "role": "断定谓语"}]}, {"s": 143.1, "e": 149.2, "ja": "剣道は伝統的な日本のスポーツです。", "zh": "剑道是传统的日本运动。", "frame": [{"s": "剣道は", "b": "［］", "role": "主语"}, {"s": "伝統的な日本のスポーツ", "b": "［］", "role": "名词表语"}, {"s": "です", "b": "（）", "role": "断定谓语"}]}, {"s": 149.2, "e": 155.0, "ja": "彼はとても剣道が上手です。", "zh": "他的剑道非常厉害。", "frame": [{"s": "彼は", "b": "［］", "role": "主题主语"}, {"s": "とても", "b": "[]", "role": "程度状语"}, {"s": "剣道が", "b": "［］", "role": "对象主语"}, {"s": "上手", "b": "［］", "role": "形容表语"}, {"s": "です", "b": "（）", "role": "断定谓语"}]}, {"s": 155.0, "e": 161.4, "ja": "私も6年間剣道をしていました。", "zh": "我也练了6年剑道。", "frame": [{"s": "