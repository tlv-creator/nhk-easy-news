谓语"}]}, {"s": 46.5, "e": 48.6, "ja": "暑いですか？", "zh": "热吗？", "frame": [{"s": "暑いですか", "b": "（）", "role": "谓语"}]}, {"s": 48.6, "e": 51.1, "ja": "雨ですか？", "zh": "下雨吗？", "frame": [{"s": "雨", "b": "〈〉", "role": "表语"}, {"s": "ですか", "b": "（）", "role": "谓语"}]}, {"s": 51.1, "e": 54.0, "ja": "雪ですか？", "zh": "下雪吗？", "frame": [{"s": "雪", "b": "〈〉", "role": "表语"}, {"s": "ですか", "b": "（）", "role": "谓语"}]}, {"s": 54.0, "e": 100.2, "ja": "ニュージーランドは今夏ですから暑いです。", "zh": "新西兰现在是夏天，所以很热。", "frame": [{"s": "ニュージーランドは", "b": "［］", "role": "主语从句"}, {"s": "今", "b": "[]", "role": "时间状语"}, {"s": "夏ですから", "b": "［］", "role": "原因状语从句"}, {"s": "暑いです", "b": "（）", "role": "谓语"}]}, {"s": 100.2, "e": 110.8, "ja": "ニュージーランドの家はあまりエアコンがありませんから、少し大変です。", "zh": "新西兰的房子大多没有空调，所以有点难受。", "frame": [{"s": "ニュージーランドの家は", "b": "［］", "role": "大主语"}, {"s": "あまり", "b": "[]", "role": "副词状语"}, {"s": "エアコンがありませんから", "b": "［］", "role": "原因状语从句"}, {"s": "少し", "b": "[]", "role": "程度状语"}, {"s": "大変です", "b": "（）", "role": "谓语"}]}, {"s": 110.8, "e": 118.0, "ja": "皆さんは暑い時、何をしますか？", "zh": "大家在天热的时候都做些什么呢？", "frame": [{"s": "皆さんは", "b": "［］", "role": "主语从句"}, {"s": "暑い時", "b": "［］", "role": "时间状语从句"}, {"s": "何を", "b": "〈〉", "role": "宾语"}, {"s": "しますか", "b": "（）", "role": "谓语"}]}, {"s": 118.0, "e": 124.6, "ja": "私は暑い時あまり外に行きません。", "zh": "我天热的时候不太去外面。", "frame": [{"s": "私は", "b": "［］", "role": "主语从句"}, {"s": "暑い時", "b": "［］", "role": "时间状语从句"}, {"s": "あまり", "b": "[]", "role": "副词状语"}, {"s": "外に", "b": "〈〉", "role": "方向状语"}, {"s": "行きません", "b": "（）", "role": "谓语"}]}, {"s": 124.6, "e": 131.7, "ja": "でも運動が好きですから、よくジムに行きます。", "zh": "但我喜欢运动，所以经常去健身房。", "frame": [{"s": "でも", "b": "[]", "role": "转折连词"}, {"s": "運動が好きですから", "b": "［］", "role": "原因状语从句"}, {"s": "よく", "b": "[]", "role": "频度状语"}, {"s": "ジムに", "b": "〈〉", "role": "目的地"}, {"s": "行きます", "b": "（）", "role": "谓语"}]}, {"s": 131.7, "e": 137.4, "ja": "ジムはあまり暑くないですから。", "zh": "因为健身房不太热。", "frame": [{"s": "ジムは", "b": "［］", "role": "主语从句"}, {"s": "あまり", "b": "[]", "role": "程度状语"}, {"s": "暑くないですから", "b": "（）", "role": "谓语"}]}, {"s": 137.4, "e": 150.3, "ja": "あと、エアコンがある喫茶店にコーヒーを飲みに行ったり、日陰を散歩したりします。", "zh": "还有就是，去有空调的咖啡店喝咖啡，或者在树荫下散散步。", "frame": [{"s": "あと", "b": "[]", "role": "连接词"}, {"s": "エアコンがある喫茶店に", "b": "［］", "role": "修饰从句"}, {"s": "コーヒーを飲みに行ったり", "b": "［］", "role": "动作列举"}, {"s": "日陰を散歩したり", "b": "［］", "role": "动作列举"}, {"s": "します", "b": "（）", "role": "谓语"}]}, {"s": 150.3, "e": 158.4, "ja": "あと、プールに行って泳いだりするのも好きです。", "zh": "另外，我也喜欢去游泳池游游泳之类的。", "frame": [{"s": "あと", "b": "[]", "role": "连接词"}, {"s": "プールに行って", "b": "［］", "role": "连用从句"}, {"s": "泳いだりするのも", "b": "［］", "role": "主语从句"}, {"s": "好きです", "b": "（）", "role": "谓语"}]}, {"s": 158.4, "e": 173.3, "ja": "ニュージーランドの紫外線はとても強いですから、ずっと外にいるのは危ないと思います。", "zh": "新西兰的紫外线非常强，所以我觉得一直待在室外很危险。", "frame": [{"s": "ニュージーランドの紫外線はとても強いですから", "b": "［］", "role": "原因状语从句"}, {"s": "ずっと外にいるのは", "b": "［］", "role": "主语从句"}, {"s": "危ないと", "b": "〈〉", "role": "引用内容"}, {"s": "思います", "b": "（）", "role": "谓语"}]}, {"s": 173.3, "e": 180.0, "ja": "私はニュージーランドの曇りの日も好きです。", "zh": "我也喜欢新西兰的阴天。", "frame": [{"s": "私は", "b": "［］", "role": "主语从句"}, {"s": "ニュージーランドの曇りの日も", "b": "〈〉", "role": "宾语"}, {"s": "好きです", "b": "（）", "role": "谓语"}]}, {"s": 180.0, "e": 186.7, "ja": "しゅんと日本語ポッドキャスト1。", "zh": "小俊的日语播客 1。", "frame": [{"s": "しゅんと日本語ポッドキャスト1", "b": "［］", "role": "标题"}]}, {"s": 186.7, "e": 192.7, "ja": "初心者、Beginners、Genki 1 level。", "zh": "初学者，Beginners，初级1水平。", "frame": [{"s": "初心者", "b": "［］", "role": "受众对象"}, {"s": "Beginners", "b": "［］", "role": "受众对象"}, {"s": "Genki 1 level", "b": "［］", "role": "难度等级"}]}, {"s": 192.7, "e": 202.8, "ja": "自己紹介、Self-introduction。", "zh": "自我介绍，Self-introduction。", "frame": [{"s": "自己紹介", "b": "［］", "role": "主题"}, {"s": "Self-introduction", "b": "［］", "role": "主题"}]}, {"s": 202.8, "e": 205.7, "ja": "はじめまして、こんにちは。", "zh": "初次见面，你好。", "frame": [{"s": "はじめまして", "b": "[]", "role": "寒暄"}, {"s": "こんにちは", "b": "[]", "role": "问候"}]}, {"s": 205.7, "e": 209.4, "ja": "日本語の勉強はどうですか？", "zh": "日语学习怎么样？", "frame": [{"s": "日本語の勉強は", "b": "［］", "role": "话题主语"}, {"s": "どうですか", "b": "（）", "role": "谓语提问"}]}, {"s": 209.4, "e": 212.1, "ja": "難しいですか？", "zh": "难吗？", "frame": [{"s": "難しいですか", "b": "（）", "role": "谓语提问"}]}, {"s": 212.1, "e": 215.2, "ja": "易しいですか？", "zh": "容易吗？", "frame": [{"s": "易しいですか", "b": "（）", "role": "谓语提问"}]}, {"s": 215.2, "e": 221.8, "ja": "私は今日から日本語のポッドキャストを始めます。", "zh": "我从今天开始做日语播客。", "frame": [{"s": "私は", "b": "［］", "role": "主语"}, {"s": "今日から", "b": "[]", "role": "时间状语"}, {"s": "日本語のポッドキャストを", "b": "〈〉", "role": "宾语"}, {"s": "始めます", "b": "（）", "role": "谓语"}]}, {"s": 221.8, "e": 225.9, "ja": "とても楽しみです。", "zh": "非常期待。", "frame": [{"s": "とても", "b": "[]", "role": "程度副词"}, {"s": "楽しみです", "b": "（）", "role": "谓语"}]}, {"s": 225.9, "e": 234.6, "ja": "私と日本語をたくさん聴いて、たくさん勉強しましょう。", "zh": "和我一起多听日语，多学日语吧。", "frame": [{"s": "私と", "b": "[]", "role": "伴随状语"}, {"s": "日本語を", "b": "〈〉", "role": "宾语"}, {"s": "たくさん", "b": "[]", "role": "数量副词"}, {"s": "聴いて", "b": "（）", "role": "谓语连接"}, {"s": "たくさん", "b": "[]", "role": "数量副词"}, {"s": "勉強しましょう", "b": "（）", "role": "谓语号召"}]}, {"s": 234.6, "e": 238.8, "ja": "今日は自己紹介です。", "zh": "今天做自我介绍。", "frame": [{"s": "今日は", "b": "［］", "role": "时间主语"}, {"s": "自己紹介です", "b": "（）", "role": "谓语断定"}]}, {"s": 238.8, "e": 242.5, "ja": "始めましょう。", "zh": "让我们开始吧。", "frame": [{"s": "始めましょう", "b": "（）", "role": "谓语号召"}]}, {"s": 242.5, "e": 246.6, "ja": "初めまして、こんにちは。", "zh": "初次见面，你好。", "frame": [{"s": "初めまして", "b": "[]", "role": "寒暄"}, {"s": "こんにちは", "b": "[]", "role": "问候"}]}, {"s": 246.6, "e": 250.1, "ja": "私の名前はしゅんです。", "zh": "我的名字是小俊。", "frame": [{"s": "私の名前は", "b": "［］", "role": "主语"}, {"s": "しゅんです", "b": "（）", "role": "谓语断定"}]}, {"s": 250.1, "e": 253.4, "ja": "私は日本人です。", "zh": "我是日本人。", "frame": [{"s": "私は", "b": "［］", "role": "主语"}, {"s": "日本人です", "b": "（）", "role": "谓语断定"}]}, {"s": 253.4, "e": 258.3, "ja": "日本の愛知県出身です。", "zh": "我来自日本的爱知县。", "frame": [{"s": "日本の愛知県出身です", "b": "（）", "role": "谓语断定"}]}, {"s": 258.3, "e": 262.2, "ja": "29歳です。", "zh": "29岁。", "frame": [{"s": "29歳です", "b": "（）", "role": "谓语断定"}]}, {"s": 262.2, "e": 268.1, "ja": "好きな食べ物はラーメンと寿司です。", "zh": "喜欢的食物是拉面和寿司。", "frame": [{"s": "好きな食べ物は", "b": "［］", "role": "主语"}, {"s": "ラーメンと寿司です", "b": "（）", "role": "谓语断定"}]}, {"s": 268.1, "e": 273.4, "ja": "好きな飲み物はコーヒーです。", "zh": "喜欢的饮品是咖啡。", "frame": [{"s": "好きな飲み物は", "b": "［］", "role": "主语"}, {"s": "コーヒーです", "b": "（）", "role": "谓语断定"}]}, {"s": 273.4, "e": 279.0, "ja": "私は毎朝コーヒーを飲みます。", "zh": "我每天早上都喝咖啡。", "frame": [{"s": "私は", "b": "［］", "role": "主语"}, {"s": "毎朝", "b": "[]", "role": "时间状语"}, {"s": "コーヒーを", "b": "〈〉", "role": "宾语"}, {"s": "飲みます", "b": "（）", "role": "谓语"}]}, {"s": 279.0, "e": 285.1, "ja": "私の趣味は旅行と運動です。", "zh": "我的爱好是旅行和运动。", "frame": [{"s": "私の趣味は", "b": "［］", "role": "主语"}, {"s": "旅行と運動です", "b": "（）", "role": "谓语断定"}]}, {"s": 285.1, "e": 291.4, "ja": "私は60カ国の国に行きました。", "zh": "我去过60个国家。", "frame": [{"s": "私は", "b": "［］", "role": "主语"}, {"s": "60カ国の国に", "b": "〈〉", "role": "方向补语"}, {"s": "行きました", "b": "（）", "role": "谓语"}]}, {"s": 291.4, "e": 300.3, "ja": "旅行についてまた他のポッドキャストで話しますね。", "zh": "关于旅行的事，以后在其他播客里再聊吧。", "frame": [{"s": "旅行について", "b": "[]", "role": "对象状语"}, {"s": "また", "b": "[]", "role": "副词"}, {"s": "他のポッドキャストで", "b": "[]", "role": "场所状语"}, {"s": "話しますね", "b": "（）", "role": "谓语确认"}]}, {"s": 300.3, "e": 305.7, "ja": "今はニュージーランドに住んでいます。", "zh": "现在住在新西兰。", "frame": [{"s": "今は", "b": "［］", "role": "时间主语"}, {"s": "ニュージーランドに", "b": "〈〉", "role": "场所补语"}, {"s": "住んでいます", "b": "（）", "role": "谓语"}]}, {"s": 305.7, "e": 322.1, "ja": "ニュージーランドの前はフィンランドとアイルランドとカナダとアメリカとオーストラリアと台湾に住んでいました。", "zh": "在新西兰之前，我曾住在芬兰、爱尔兰、加拿大、美国、澳大利亚和台湾。", "frame": [{"s": "ニュージーランドの前は", "b": "［］", "role": "时间主语"}, {"s": "フィンランドと", "b": "〈〉", "role": "并列宾语"}, {"s": "アイルランドと", "b": "〈〉", "role": "并列宾语"}, {"s": "カナダと", "b": "〈〉", "role": "并列宾语"}, {"s": "アメリカと", "b": "〈〉", "role": "并列宾语"}, {"s": "オーストラリアと", "b": "〈〉", "role": "并列宾语"}, {"s": "台湾に", "b": "〈〉", "role": "场所补语"}, {"s": "住んでいました", "b": "（）", "role": "谓语"}]}, {"s": 322.1, "e": 328.0, "ja": "私は本当に旅行が好きです。", "zh": "我真的很喜欢旅行。", "frame": [{"s": "私は", "b": "［］", "role": "主语"}, {"s": "本当に", "b": "[]", "role": "程度副词"}, {"s": "旅行が", "b": "〈〉", "role": "对象"}, {"s": "好きです", "b": "（）", "role": "谓语"}]}, {"s": 328.0, "e": 336.4, "ja": "ニュージーランドはとても静かで綺麗な国です。", "zh": "新西兰是一个非常安静美丽的国家。", "frame": [{"s": "ニュージーランドは", "b": "［］", "role": "主语"}, {"s": "とても静かで綺麗な国です", "b": "（）", "role": "谓语断定"}]}, {"s": 336.4, "e": 344.7, "ja": "でも、美味しい日本料理があまりありませんから、ちょっと残念です。", "zh": "但是，因为没有什么好吃的日本料理，所以有点遗憾。", "frame": [{"s": "でも", "b": "[]", "role": "接续词"}, {"s": "美味しい日本料理が", "b": "［］", "role": "从句主语"}, {"s": "あまり", "b": "[]", "role": "程度副词"}, {"s": "ありませんから", "b": "（）", "role": "原因从句谓语"}, {"s": "ちょっと", "b": "[]", "role": "程度副词"}, {"s": "残念です", "b": "（）", "role": "主句谓语"}]}, {"s": 344.7, "e": 350.1, "ja": "私の仕事は日本語の先生です。", "zh": "我的工作是日语老师。", "frame": [{"s": "私の仕事は", "b": "［］", "role": "主语"}, {"s": "日本語の先生です", "b": "（）", "role": "谓语断定"}]}, {"s": 350.1, "e": 355.7, "ja": "italkiで日本語を教えています。", "zh": "我在 italki 上教日语。", "frame": [{"s": "italkiで", "b": "[]", "role": "场所状语"}, {"s": "日本語を", "b": "〈〉", "role": "宾语"}, {"s": "教えています", "b": "（）", "role": "谓语"}]}, {"s": 355.7, "e": 360.0, "ja": "italkiは日本語を教える", "zh": "italki 是一个教日语的……", "frame": [{"s": "italkiは", "b": "［］", "role": "主语"}, {"s": "日本語を教える", "b": "［］", "role": "定语从句"}]}, {"s": 360.0, "e": 366.0, "ja": "新しい単語や文法を覚えましょう。", "zh": "记住新的单词和语法吧。", "frame": [{"s": "新しい単語や文法を", "b": "〈〉", "role": "宾语"}, {"s": "覚えましょう", "b": "（）", "role": "谓语"}]}, {"s": 366.0, "e": 371.2, "ja": "では、次のポッドキャストで会いましょう。", "zh": "那么，我们在下一期播客再见吧。", "frame": [{"s": "では", "b": "[]", "role": "连接词"}, {"s": "次のポッドキャストで", "b": "〈〉", "role": "状语"}, {"s": "会いましょう", "b": "（）", "role": "谓语"}]}, {"s": 371.2, "e": 373.0, "ja": "じゃあ、またね。", "zh": "那么，回头见啦。", "frame": [{"s": "じゃあ", "b": "[]", "role": "连接词"}, {"s": "またね", "b": "（）", "role": "谓语"}]}, {"s": 373.0, "e": 391.0, "ja": "バイバイ。", "zh": "拜拜。", "frame": [{"s": "バイバイ", "b": "（）", "role": "谓语"}]}], "n": 