{"g_00":{"name":"に〜（方向/对象/时间点）","short":"に〜","cat":"句型","conn":"名詞 + に","mean":"方向、对象、时间点、目的地","feel":"「学校に行く」「友達に会う」","example":"皆さんこんにちは。","exampleZh":"大家好。"},"g_01":{"name":"を〜（宾语助词）","short":"を〜","cat":"助词","conn":"他動詞 + を","mean":"标记他动词的宾语","feel":"他动词必须有宾语，用「を」","example":"今、おさななじみと遊ぶときは友達はよく仕事の話をします","exampleZh":"现在和青梅竹马一起玩的时候，朋友们经常聊工作的事，"},"g_02":{"name":"で〜（手段/场所/原因）","short":"で〜","cat":"句型","conn":"名詞 + で","mean":"手段、场所、原因","feel":"「電車で行く」「家で」","example":"日本語教師のシュンです。","exampleZh":"我是日语老师 Shun。"},"g_03":{"name":"から〜（起点/原因）","short":"から〜","cat":"句型","conn":"名詞 + から","mean":"起点、原因","feel":"「九時から」「yeong」","example":"子供の時から仲がいい友達ですねどう","exampleZh":"是从小关系就好的朋友。怎么"},"g_04":{"name":"と〜（和/引用）","short":"と〜","cat":"句型","conn":"名詞 + と","mean":"和…一起；引用内容","feel":"「友達と話す」「\"はい\"と答えた」","example":"シュンと日本語。","exampleZh":"Shun 日语播客。"},"g_05":{"name":"の〜（所属/修饰）","short":"の〜","cat":"句型","conn":"名詞 + の + 名詞","mean":"的；所属；修饰","feel":"「友達の本」","example":"昔の友達。","exampleZh":"老朋友。"},"g_06":{"name":"は〜です（主题是〜）","short":"は〜です","cat":"断定","conn":"名詞 + は + 名詞 / 動形 + です","mean":"主题是…（是…）","feel":"提示主题：「料理は美味しいです」","example":"ずは昔の友達です","exampleZh":"先是老朋友，"},"g_07":{"name":"〜ことができます（能够…）","short":"〜ことができます","cat":"句型","conn":"動形 + ことができます","mean":"能够做某事（能力）","feel":"用「潜在能力」的说法，比「できます」更书面","example":"私はいつも仕事を忘れて楽しむことができます","exampleZh":"我总是能忘掉工作，好好地享受。"},"g_08":{"name":"より〜（比较）","short":"より〜","cat":"句型","conn":"名詞 + より","mean":"比…（更…）","feel":"比较的基准用「より」","example":"AIは本当に人間より100倍、","exampleZh":"AI 真的能比人类快 100 倍、"},"g_09":{"name":"〜よね（…对吧）","short":"〜よね","cat":"断定","conn":"動形 + よね","mean":"寻求确认（对吧）","feel":"口语确认：「そうだよね」","example":"早すぎますよね","exampleZh":"太快了吧。"},"g_10":{"name":"が〜です（主语是〜）","short":"が〜です","cat":"断定","conn":"名詞 + が + 名詞 / 動形 + です","mean":"主语是…；…才是…","feel":"描述对象或强调「A 才是 B」","example":"人とのつながりを感じてほしいです","exampleZh":"不那么方便的世界，能感受到人与人之间的联系。"},"g_11":{"name":"まで〜（终点）","short":"まで〜","cat":"句型","conn":"名詞 + まで","mean":"到…为止、终点","feel":"「五時まで」","example":"でも私はあまり最近まで海についてこんなに感じていません