<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.shun.study"
    android:versionCode="9"
    android:versionName="1.4.0">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 🔴 前台服务：锁屏 / 切后台 / 划掉界面都要能继续出声。
         纯 WebView 一进后台就会被系统回收进程 ⇒ 断声 ⇒ 必须有前台服务保活。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Android 13+ 显示通知需要（不给也不影响播放，只是没有锁屏控制） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="日語精読 Shun"
        android:icon="@drawable/icon"
        android:usesCleartextTraffic="false"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 🔴🔴 前台播放服务：让「锁屏 / 切后台 / 划掉界面」不断声。
             只在**真的要播了**的时候才起（不在启动路径上）→ 避开前台服务 5 秒红线。 -->
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
