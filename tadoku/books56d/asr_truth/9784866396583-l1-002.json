[{"start": 0.0, "text": "着物"}, {"start": 2.0, "text": "作"}, {"start": 3.0, "text": "川本和子"}, {"start": 8.0, "text": "着物のいろいろ"}, {"start": 12.0, "text": "わあ、きれい。"}, {"start": 15.0, "text": "いろいろな着物がありますね。"}, {"start": 20.0, "text": "着物はいつから？"}, {"start": 24.0, "text": "日本の着物は平安時代に生まれました。"}, {"start": 31.0, "text": "この時代、男の人も女の人も一番下に白い着物を着ました。"}, {"start": 40.0, "text": "小袖です。"}, {"start": 43.0, "text": "そして、その上に袴をはきました。"}, {"start": 49.0, "text": "女の人は小袖の上に、着物をたくさん着ました。"}, {"start": 58.0, "text": "夏は5枚くらい、冬は20枚くらい着ました。"}, {"start": 66.0, "text": "一番下の小袖が、今の着物の始まりです。"}, {"start": 74.0, "text": "鎌倉時代や室町時代には、女の人は袴をは"}, {"start": 80.0, "text": "着ませんでした。"}, {"start": 83.0, "text": "綺麗な小袖を一番上に着ました。"}, {"start": 88.0, "text": "そして小袖に帯をしました。"}, {"start": 94.0, "text": "安土桃山時代には、小袖の上にもう一枚小袖を着ました。"}, {"start": 103.0, "text": "江戸時代は長いですから、着物もいろいろあります。"}, {"start": 111.0, "text": "この時代の終わりには、今の着物や帯と同じものもありました。"}, {"start": 120.0, "text": "明治時代にヨーロッパから洋服が来ました。"}, {"start": 127.0, "text": "でも、明治時代、大正時代にはまだ着物の人がたくさんいました。"}, {"start": 137.0, "text": "今、日本人はあまり着物を着ません。"}, {"start": 143.0, "text": "洋服を着ます。"}, {"start": 146.0, "text": "では、着物はいつ着ますか。"}, {"start": 152.0, "text": "いつ着物を着ますか。"}, {"start": 156.0, "text": "お宮参り。"}, {"start": 160.0, "text": "1か月の赤ちゃん、おめでとう。"}, {"start": 164.0, "text": "お父さんとお母さんと神社へ行きます。"}, {"start": 171.0, "text": "七五三。"}, {"start": 175.0, "text": "11月15日です。"}, {"start": 180.0, "text": "3歳の女の子、5歳の男の子、7歳の女の子、おめでとう。"}, {"start": 190.0, "text": "みんな神社へ行きます。"}, {"start": 195.0, "text": "成人式。"}, {"start": 198.0, "text": "1月の"}, {"start": 200.0, "text": "第二日曜日です。"}, {"start": 203.0, "text": "二十歳、おめでとう。"}, {"start": 206.0, "text": "二十歳は、大人です。"}, {"start": 210.0, "text": "もう、子供じゃありません。"}, {"start": 213.0, "text": "お酒もタバコも、いいですよ。"}, {"start": 219.0, "text": "大学の卒業式。"}, {"start": 223.0, "text": "3月です。"}, {"start": 226.0, "text": "卒業、おめでとう。"}, {"start": 229.0, "text": "大変な勉強も、楽しいことも、たくさんありました。"}, {"start": 237.0, "text": "結婚式。"}, {"start": 241.0, "text": "結婚おめでとうございます。"}, {"start": 244.0, "text": "花嫁さんは打掛。"}, {"start": 248.0, "text": "花婿さんは羽織袴。"}, {"start": 253.0, "text": "お母さんたちは留袖。"}, {"start": 257.0, "text": "お父さんたちだけ洋服です。"}, {"start": 261.0, "text": "モーニングを着ます。"}, {"start": 266.0, "text": "着物を作ります。"}, {"start": 270.0, "text": "着物は1枚の布から作ります。"}, {"start": 276.0, "text": "1、布を切ります。"}, {"start": 280.0, "text": "2"}, {"start": 281.0, "text": "縫います"}, {"start": 285.0, "text": "着物を着ましょう"}, {"start": 289.0, "text": "女の人"}, {"start": 292.0, "text": "1　足袋を履きます"}, {"start": 297.0, "text": "2　裾よけを着ます"}, {"start": 302.0, "text": "3　肌襦袢を着ます"}, {"start": 306.0, "text": "4　タオルを入れます"}, {"start": 311.0, "text": "5　長襦袢を着ます"}, {"start": 316.0, "text": "6　着物を着ます"}, {"start": 320.0, "text": "7"}, {"start": 321.0, "text": "帯をしめます。"}, {"start": 324.0, "text": "きれいですね。"}, {"start": 328.0, "text": "男の人"}, {"start": 331.0, "text": "1から6まで女の人と同じです。"}, {"start": 337.0, "text": "7"}, {"start": 338.0, "text": "袴をはきます。"}, {"start": 342.0, "text": "8"}, {"start": 343.0, "text": "羽織を着ます。"}, {"start": 346.0, "text": "かっこいいですね。"}, {"start": 350.0, "text": "いいですか？"}, {"start": 352.0, "text": "だめですか？"}, {"start": 356.0, "text": "右前に着ます。"}, {"start": 360.0, "text": "髪を上げます。"}, {"start": 363.0, "text": "腕を出しません。"}, {"start": 366.0, "text": "小さく静かに歩きます。"}, {"start": 372.0, "text": "浴衣を着ましょう。"}, {"start": 375.0, "text": "浴衣は夏の着物です。"}, {"start": 380.0, "text": "さあ、浴衣を着ましょう。"}, {"start": 385.0, "text": "そして、花火大会に行きましょう。"}]