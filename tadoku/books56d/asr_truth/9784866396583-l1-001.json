[{"start": 12.0, "text": "レベル別"}, {"start": 14.0, "text": "日本語多読ライブラリー"}, {"start": 16.0, "text": "にほんご"}, {"start": 18.0, "text": "よむよむ文庫"}, {"start": 20.0, "text": "レベル1"}, {"start": 22.0, "text": "監修"}, {"start": 24.0, "text": "NPO法人"}, {"start": 26.0, "text": "日本語多読研究会"}, {"start": 31.0, "text": "バス"}, {"start": 33.0, "text": "作"}, {"start": 35.0, "text": "まつだみどり"}, {"start": 40.0, "text": "鈴木正男さんは二十歳です。"}, {"start": 44.0, "text": "バスの運転手です。"}, {"start": 48.0, "text": "毎日上田から丸山までバスを運転します。"}, {"start": 56.0, "text": "ある日の夜です。"}, {"start": 59.0, "text": "秋の静かな夜でした。"}, {"start": 64.0, "text": "鈴木さんのバスは午後10時に上田を出ました。"}, {"start": 72.0, "text": "お客さんは8人です。"}, {"start": 76.0, "text": "バス停に着きました。"}, {"start": 80.0, "text": "お客さんが3人降りました。"}, {"start": 86.0, "text": "次のバス停に着きました。"}, {"start": 90.0, "text": "お客さんがまた3人降りました。"}, {"start": 97.0, "text": "また次のバス停に着きました。"}, {"start": 103.0, "text": "男の人と女の人が降りました。"}, {"start": 108.0, "text": "もうバスの中にお客さんはいません。"}, {"start": 115.0, "text": "前に大きいトラックがいます。"}, {"start": 120.0, "text": "鈴木さんのバスは、そのトラックの後ろを走ります。"}, {"start": 127.0, "text": "「ああ、今日の仕事も、もう終わりだなあ。"}, {"start": 133.0, "text": "早くうちへ帰りたい。"}, {"start": 136.0, "text": "早く寝たいなあ。」"}, {"start": 140.0, "text": "その時、前の大きいトラックが止まりました。"}, {"start": 146.0, "text": "「うわあ、危ない！」"}, {"start": 150.0, "text": "鈴木さんは、バスのブレーキを踏みました。"}, {"start": 155.0, "text": "強く踏みました。"}, {"start": 158.0, "text": "キキキキキー！"}, {"start": 161.0, "text": "鈴木さんは目を開けました。"}, {"start": 167.0, "text": "とても静かです。"}, {"start": 170.0, "text": "大きいトラックはもういません。"}, {"start": 176.0, "text": "「ああ、危なかった。」"}, {"start": 181.0, "text": "鈴木さんはまたバスを運転しました。"}, {"start": 187.0, "text": "次のバス停は丸山東です。"}, {"start": 193.0, "text": "バス停に誰かいます。"}, {"start": 197.0, "text": "鈴木さんのバスは"}, {"start": 200.0, "text": "止まりました。"}, {"start": 203.0, "text": "お客さんが一人乗りました。"}, {"start": 207.0, "text": "鈴木さんはお客さんの顔を見ました。"}, {"start": 212.0, "text": "「え？"}, {"start": 213.0, "text": "お、おばあちゃん？"}, {"start": 217.0, "text": "ど、どうして？」"}, {"start": 221.0, "text": "お客さんは鈴木さんのおばあさんでした。"}, {"start": 226.0, "text": "おばあさんは言いました。"}, {"start": 230.0, "text": "「正男、元気でしたか？"}, {"start": 234.0, "text": "正男はバスが好きでしたね。"}, {"start": 238.0, "text": "今、正…"}, {"start": 240.0, "text": "あら、バスの運転手さん。"}, {"start": 243.0, "text": "おばあちゃんは嬉しいですよ。"}, {"start": 248.0, "text": "鈴木さんのおばあさんは10年前、病気で死にました。"}, {"start": 255.0, "text": "鈴木さんはおばあさんが大好きでした。"}, {"start": 261.0, "text": "おばあちゃん？"}, {"start": 263.0, "text": "ええ、そうですよ。"}, {"start": 266.0, "text": "おばあちゃん、すぐ仕事が終わります。"}, {"start": 270.0, "text": "一緒に帰りましょう。"}, {"start": 273.0, "text": "正男、それはできません。"}, {"start": 276.0, "text": "おばあちゃんのうちはとても遠いと…"}, {"start": 280.0, "text": "ところにありますから。"}, {"start": 282.0, "text": "え？"}, {"start": 283.0, "text": "遠いところ？"}, {"start": 285.0, "text": "そう。遠いところ。"}, {"start": 288.0, "text": "だから、まさおは、まさおの家へ、"}, {"start": 293.0, "text": "前はだめですよ。"}, {"start": 295.0, "text": "後ろですよ。"}, {"start": 298.0, "text": "え？"}, {"start": 299.0, "text": "前はだめ？"}, {"start": 301.0, "text": "どうして？"}, {"start": 304.0, "text": "鈴木さんは前を見ました。"}, {"start": 308.0, "text": "そして、またバスの中を見ました。"}, {"start": 314.0, "text": "おばあさんがいません。"}, {"start": 318.0, "text": "おばあちゃん、"}, {"start": 320.0, "text": "「どこ？"}, {"start": 321.0, "text": "どこ？」"}, {"start": 323.0, "text": "「前はだめですよ。」"}, {"start": 326.0, "text": "おばあさんの声です。"}, {"start": 328.0, "text": "「後ろですよ。"}, {"start": 330.0, "text": "後ろへ、後ろへ。"}, {"start": 334.0, "text": "さようなら、まさお。"}, {"start": 336.0, "text": "さようなら。」"}, {"start": 340.0, "text": "鈴木さんは後ろを見ました。"}, {"start": 345.0, "text": "「あれ？"}, {"start": 347.0, "text": "後ろはとても明るい。"}, {"start": 350.0, "text": "どうして？」"}, {"start": 352.0, "text": "「後ろへ、後ろへ。」"}, {"start": 356.0, "text": "また、おばあさんの声です。"}, {"start": 360.0, "text": "鈴木さんのバスは後ろへ行きました。"}, {"start": 367.0, "text": "うわあ、明るい。"}, {"start": 372.0, "text": "ここはどこ？"}, {"start": 376.0, "text": "あ、人の声が……"}, {"start": 380.0, "text": "正男、正男！"}, {"start": 383.0, "text": "お母さんの声です。"}, {"start": 385.0, "text": "正男、正男！"}, {"start": 389.0, "text": "お父さんの声です。"}, {"start": 393.0, "text": "鈴木さんは目を開けました。"}, {"start": 398.0, "text": "あ、"}, {"start": 400.0, "text": "明るい。"}, {"start": 404.0, "text": "お母さんの顔、"}, {"start": 406.0, "text": "お父さんの顔。"}, {"start": 409.0, "text": "そして、白い服の医者。"}, {"start": 414.0, "text": "鈴木さんのバスは、大きいトラックにぶつかりました。"}, {"start": 421.0, "text": "でも、鈴木さんは死にませんでした。"}, {"start": 427.0, "text": "鈴木さんは、3か月病院にいました。"}, {"start": 433.0, "text": "鈴木さんは今、とても元気です。"}, {"start": 439.0, "text": "今日も"}, {"start": 440.0, "text": "元気にバスを運転します。"}, {"start": 444.0, "text": "そして、丸山東のバス停で今日も言います。"}, {"start": 453.0, "text": "「おばあちゃん、"}, {"start": 455.0, "text": "ありがとう。」"}]