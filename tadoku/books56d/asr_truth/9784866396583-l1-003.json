[{"start": 0.0, "text": "どうして エビの体は 曲がった？"}, {"start": 4.0, "text": "どうして 猫年が ない？"}, {"start": 9.0, "text": "再話"}, {"start": 10.0, "text": "織田 まさ子"}, {"start": 15.0, "text": "どうして エビの体は 曲がった？"}, {"start": 20.0, "text": "何千年も 前、"}, {"start": 23.0, "text": "エビの体は まっすぐでした。"}, {"start": 28.0, "text": "でも、 ある日、"}, {"start": 30.0, "text": "エビの体は 曲がりました。"}, {"start": 35.0, "text": "それは どうしてでしょう。"}, {"start": 40.0, "text": "ある川にとても大きいエビがいました。"}, {"start": 47.0, "text": "川で一番大きいエビでした。"}, {"start": 52.0, "text": "エビは言いました。"}, {"start": 55.0, "text": "もっと大きいものに会いたい。"}, {"start": 58.0, "text": "そうだ、海だ。"}, {"start": 62.0, "text": "海がいい。"}, {"start": 66.0, "text": "エビは海へ行きました。"}, {"start": 70.0, "text": "海の中には魚がたくさんいました。"}, {"start": 75.0, "text": "でも、大きい魚はいませんでした。"}, {"start": 81.0, "text": "僕が一番大きい。"}, {"start": 84.0, "text": "もっと大きいものに会いたい。"}, {"start": 90.0, "text": "えびは海の中を歩きました。"}, {"start": 94.0, "text": "でも、もっと大きいものはいませんでした。"}, {"start": 101.0, "text": "えびはまた海の中を歩きました。"}, {"start": 106.0, "text": "もっと大きいものはいないなあ。"}, {"start": 112.0, "text": "もう夜です。"}, {"start": 115.0, "text": "えびはとても疲れました。"}, {"start": 119.0, "text": "ああ。"}, {"start": 120.0, "text": "「もう寝たいなぁ。」"}, {"start": 125.0, "text": "エビの前に穴がありました。"}, {"start": 130.0, "text": "「あ、ここがいい。"}, {"start": 133.0, "text": "ここで寝ましょう。」"}, {"start": 136.0, "text": "エビはその穴の中で寝ました。"}, {"start": 142.0, "text": "次の日の朝です。"}, {"start": 145.0, "text": "クジラがいます。"}, {"start": 148.0, "text": "「ん？"}, {"start": 150.0, "text": "鼻が……"}, {"start": 153.0, "text": "あれ？"}, {"start": 155.0, "text": "鼻の中が……"}, {"start": 158.0, "text": "は……」"}, {"start": 160.0, "text": "ハックショーン！"}, {"start": 163.0, "text": "クジラがくしゃみをしました。"}, {"start": 167.0, "text": "ひゃああ！"}, {"start": 170.0, "text": "ドッスーン！"}, {"start": 172.0, "text": "痛い！"}, {"start": 176.0, "text": "それから、エビの体は曲がりました。"}]