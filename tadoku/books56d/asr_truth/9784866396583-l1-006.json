[{"start": 0.0, "text": "ジョンさんの夏休み"}, {"start": 4.0, "text": "作　川本かず子"}, {"start": 11.0, "text": "ジョンさんの学校は、今、夏休みです。"}, {"start": 16.0, "text": "夏休みは、8月1日から31日までです。"}, {"start": 26.0, "text": "今日は、8月5日です。"}, {"start": 30.0, "text": "ジョンさんは、これから仙台へ行きます。"}, {"start": 35.0, "text": "森さんの家に、8日までホームステイを"}, {"start": 40.0, "text": "します。"}, {"start": 42.0, "text": "東京から新幹線で仙台へ行きます。"}, {"start": 49.0, "text": "ここは仙台駅です。"}, {"start": 53.0, "text": "仙台駅で森さんに会います。"}, {"start": 58.0, "text": "ええと、森さんは…"}, {"start": 63.0, "text": "青いシャツの背が高い人。"}, {"start": 67.0, "text": "あ、あの人？"}, {"start": 71.0, "text": "改札の前に青いシャツの背が高い女の人がいます。"}, {"start": 78.0, "text": "うわあ、"}, {"start": 80.0, "text": "きれいな人。"}, {"start": 83.0, "text": "ジョンさんはその人に言いました。"}, {"start": 88.0, "text": "「初めまして。"}, {"start": 89.0, "text": "ジョンです。"}, {"start": 92.0, "text": "どうぞよろしく。」"}, {"start": 94.0, "text": "でも、女の人は何も言いません。"}, {"start": 100.0, "text": "「あ、"}, {"start": 102.0, "text": "す、"}, {"start": 103.0, "text": "すみません。」"}, {"start": 106.0, "text": "男の人が来ました。"}, {"start": 109.0, "text": "そして言いました。"}, {"start": 112.0, "text": "「あの、"}, {"start": 114.0, "text": "ジョンさんですか？」"}, {"start": 117.0, "text": "「え？"}, {"start": 118.0, "text": "あ、"}, {"start": 120.0, "text": "「はい。ジョンです。」"}, {"start": 123.0, "text": "ジョンさんは男の人を見ました。"}, {"start": 127.0, "text": "青いシャツの背が高い男の人です。"}, {"start": 133.0, "text": "ジョンさんは言いました。"}, {"start": 136.0, "text": "「森さんですか？"}, {"start": 139.0, "text": "初めまして。"}, {"start": 142.0, "text": "どうぞよろしくお願いします。」"}, {"start": 145.0, "text": "森さんが言いました。"}, {"start": 148.0, "text": "「こちらこそ、どうぞよろしく。」"}, {"start": 153.0, "text": "二人は森さんの車で森さんの家へ行きます。"}, {"start": 160.0, "text": "ジョンさんは 今日から 森さんの家に ホームステイをします。"}, {"start": 169.0, "text": "夜です。"}, {"start": 171.0, "text": "これから みんなで 晩ご飯を食べます。"}, {"start": 176.0, "text": "森さんの家族は 4人です。"}, {"start": 180.0, "text": "森さん、奥さんの京子さん、"}, {"start": 185.0, "text": "子供のひろし君、7歳。"}, {"start": 189.0, "text": "そして おばあちゃんの まさこさん。"}, {"start": 195.0, "text": "みんなで 色々な話をしました。"}, {"start": 200.0, "text": "そして おいしい料理をたくさん食べました。"}, {"start": 206.0, "text": "とても おいしかったです。"}, {"start": 209.0, "text": "ごちそうさまでした。"}, {"start": 212.0, "text": "お父さん、今日は花火の日だよ。"}, {"start": 216.0, "text": "うん、そうだね。"}, {"start": 218.0, "text": "じゃあ、みんなで行きましょう。"}, {"start": 221.0, "text": "花火ですか？"}, {"start": 223.0, "text": "いいですね。"}, {"start": 225.0, "text": "ジョンさん、早く、早く！"}, {"start": 229.0, "text": "はい。"}, {"start": 230.0, "text": "あれ？ 足が…"}, {"start": 233.0, "text": "うわ、足が…"}, {"start": 236.0, "text": "ジョンさん、大丈夫？"}, {"start": 238.0, "text": "大丈夫…"}, {"start": 240.0, "text": "じゃありません。"}, {"start": 243.0, "text": "みんなで花火を見ます。"}, {"start": 247.0, "text": "ドーン。"}, {"start": 249.0, "text": "わあ、きれい。"}, {"start": 252.0, "text": "うわあ、大きい。"}, {"start": 257.0, "text": "今日は8月7日です。"}, {"start": 260.0, "text": "七夕の日です。"}, {"start": 263.0, "text": "七夕の日は東京では7月7日ですが、仙台では8月7日です。"}, {"start": 274.0, "text": "仙台の七夕まつりはとても有名です。"}, {"start": 280.0, "text": "七夕の話は中国から来ました。"}, {"start": 285.0, "text": "女の星、織姫と男の星、彦星が1年に1回、天の川で会います。"}, {"start": 298.0, "text": "その日が七夕の日です。"}, {"start": 303.0, "text": "七夕に日本では家に笹を置きます。"}, {"start": 309.0, "text": "そして短冊にお願いを書きます。"}, {"start": 314.0, "text": "ジョンさんも昨日、短冊にお願いを書きま…"}, {"start": 320.0, "text": "明日、女の友達が欲しい。"}, {"start": 327.0, "text": "七夕祭りの日、町はとてもにぎやかです。"}, {"start": 335.0, "text": "森さんの家族とジョンさんは町へ行きます。"}, {"start": 341.0, "text": "夕方、ジョンさんは森さんの家族と家を出ました。"}, {"start": 348.0, "text": "家の前に笹があります。"}, {"start": 352.0, "text": "みんなの短冊があります。"}, {"start": 356.0, "text": "ジョンさんはひろし君の短冊を見ま□"}, {"start": 360.0, "text": "した。"}, {"start": 362.0, "text": "大きい犬が欲しい"}, {"start": 366.0, "text": "ジョンさんと森さんの家族は町に来ました。"}, {"start": 372.0, "text": "人がたくさんいます。"}, {"start": 375.0, "text": "とてもにぎやかです。"}, {"start": 378.0, "text": "町はとてもきれいです。"}, {"start": 382.0, "text": "「わあ、きれいですね。」"}, {"start": 388.0, "text": "ジョンさんとヒロシ君はかき氷を食べました。"}, {"start": 393.0, "text": "森さんと奥さんはビールを飲みました。"}, {"start": 398.0, "text": "おばあさん"}, {"start": 400.0, "text": "は、スイカを食べました。"}, {"start": 404.0, "text": "8月8日です。"}, {"start": 408.0, "text": "森さん、京子さん、ひろし君、おばあちゃん、ありがとうございました。"}, {"start": 419.0, "text": "とても楽しかったです。"}, {"start": 422.0, "text": "皆さん、さようなら。"}, {"start": 426.0, "text": "ジョンさん、さようなら！"}, {"start": 429.0, "text": "元気でね！"}, {"start": 432.0, "text": "ジョンさんは東京へ帰ります。"}, {"start": 438.0, "text": "今、ジ"}, {"start": 440.0, "text": "ジョンさんは東京の東西デパートにいます。"}, {"start": 445.0, "text": "大きい犬を買います。"}, {"start": 448.0, "text": "大きい犬のぬいぐるみです。"}, {"start": 452.0, "text": "ひろし君にあげます。"}, {"start": 455.0, "text": "ジョンさんはデパートの人に言いました。"}, {"start": 460.0, "text": "すみません。"}, {"start": 461.0, "text": "これを仙台に送りたいんですが。"}, {"start": 465.0, "text": "はい。"}, {"start": 466.0, "text": "では、ここにご住所とお名前をお願いします。"}, {"start": 472.0, "text": "はい。"}, {"start": 473.0, "text": "ジョンさんは住所と名前を書きました。"}, {"start": 480.0, "text": "二日後です。"}, {"start": 483.0, "text": "ジョンさんの家に誰か来ました。"}, {"start": 488.0, "text": "ピンポーン。"}, {"start": 490.0, "text": "ピンポーン。"}, {"start": 493.0, "text": "はーい。"}, {"start": 496.0, "text": "東西デパートです。"}, {"start": 499.0, "text": "ジョンさんはドアを開けました。"}, {"start": 503.0, "text": "男の人の手に大きい箱があります。"}, {"start": 508.0, "text": "東西デパートの箱です。"}, {"start": 513.0, "text": "え？"}, {"start": 514.0, "text": "東西デパート？"}, {"start": 517.0, "text": "あれ？"}, {"start": 519.0, "text": "これは…"}, {"start": 520.0, "text": "あ、これは仙台に…"}, {"start": 525.0, "text": "ここじゃないですよ。"}, {"start": 528.0, "text": "え？"}, {"start": 530.0, "text": "仙台の森ひろし様から東京のジョン様へですよ。"}, {"start": 535.0, "text": "えー？"}]