[{"start": 0.0, "text": "どうして猫年がない？"}, {"start": 5.0, "text": "あなたは何年に生まれましたか。"}, {"start": 10.0, "text": "1994年です。"}, {"start": 14.0, "text": "犬年生まれですよ。"}, {"start": 17.0, "text": "私は1992年に生まれましたから、猿年です。"}, {"start": 26.0, "text": "犬？"}, {"start": 27.0, "text": "猿？"}, {"start": 29.0, "text": "年に、動物の名前？"}, {"start": 35.0, "text": "日本では、年に動物の名前があります。"}, {"start": 40.0, "text": "皆さんの国でもありますか。"}, {"start": 46.0, "text": "動物は全部で12です。"}, {"start": 51.0, "text": "ねずみ、"}, {"start": 53.0, "text": "うし、"}, {"start": 55.0, "text": "とら、"}, {"start": 57.0, "text": "うさぎ、"}, {"start": 59.0, "text": "たつ、"}, {"start": 61.0, "text": "へび、"}, {"start": 63.0, "text": "うま、"}, {"start": 65.0, "text": "ひつじ、"}, {"start": 68.0, "text": "さる、"}, {"start": 70.0, "text": "とり、"}, {"start": 72.0, "text": "いぬ、"}, {"start": 74.0, "text": "いのししです。"}, {"start": 78.0, "text": "12の中に"}, {"start": 80.0, "text": "猫はいません。"}, {"start": 82.0, "text": "それはどうしてでしょう。"}, {"start": 87.0, "text": "とても古い話です。"}, {"start": 91.0, "text": "1年の終わり、12月31日の朝、神様が動物たちに言いました。"}, {"start": 104.0, "text": "明日は1月1日です。"}, {"start": 108.0, "text": "新しい年が始まります。"}, {"start": 113.0, "text": "明日の朝、私の家へみんな来なさい。"}, {"start": 118.0, "text": "早く来なさい。"}, {"start": 122.0, "text": "1番の動物に新しい年をあげます。"}, {"start": 128.0, "text": "2番の動物に次の年をあげます。"}, {"start": 134.0, "text": "3番の動物にその次の年をあげます。"}, {"start": 141.0, "text": "12番の動物まで年をあげます。"}, {"start": 148.0, "text": "動物たちは神様の話を聞きました。"}, {"start": 153.0, "text": "でも、猫は"}, {"start": 158.0, "text": "神様の"}, {"start": 160.0, "text": "話が終わりました。"}, {"start": 162.0, "text": "猫が起きました。"}, {"start": 165.0, "text": "猫はねずみに聞きました。"}, {"start": 170.0, "text": "「ねずみさん、神様の話は何でしたか？」"}, {"start": 177.0, "text": "ねずみは答えました。"}, {"start": 180.0, "text": "「年の話でした。"}, {"start": 183.0, "text": "十二の動物が年をもらいます。」"}, {"start": 187.0, "text": "「十二？」"}, {"start": 190.0, "text": "「そうです。十二です。"}, {"start": 193.0, "text": "一月一日に、あ、いいえ、一月……」"}, {"start": 200.0, "text": "2日にみんな神様の家へ行きます。"}, {"start": 205.0, "text": "1番から12番までの動物が年をもらいます。"}, {"start": 212.0, "text": "そうですか。"}, {"start": 214.0, "text": "1月2日ですね。"}, {"start": 217.0, "text": "ありがとう。"}, {"start": 221.0, "text": "12月31日の夜です。"}, {"start": 226.0, "text": "牛が言いました。"}, {"start": 229.0, "text": "「僕はこれから家を出ます。"}, {"start": 234.0, "text": "ゆっくり歩きますから。」"}, {"start": 238.0, "text": "ネズミは"}, {"start": 240.0, "text": "屋根の上で、牛の言葉を聞きました。"}, {"start": 245.0, "text": "そして、牛に乗りました。"}, {"start": 251.0, "text": "1月1日の朝です。"}, {"start": 255.0, "text": "神様の家の前に、牛がいます。"}, {"start": 261.0, "text": "門が開きました。"}, {"start": 265.0, "text": "ねずみが、牛から降りました。"}, {"start": 269.0, "text": "そして、門の中に入りました。"}, {"start": 274.0, "text": "ねずみが、1番です。"}, {"start": 278.0, "text": "次が、牛"}, {"start": 280.0, "text": "いです。"}, {"start": 282.0, "text": "3番はとらでした。"}, {"start": 286.0, "text": "それから、うさぎ、たつ、へび、うま、ひつじ、さる、とり、いぬ、いのししが来ました。"}, {"start": 307.0, "text": "神様は言いました。"}, {"start": 311.0, "text": "「あなたたちに年をあげます。」"}, {"start": 317.0, "text": "次の日、1月"}, {"start": 320.0, "text": "2日の朝早く、猫が来ました。"}, {"start": 325.0, "text": "猫は神様に言いました。"}, {"start": 329.0, "text": "「神様、私が1番ですね。」"}, {"start": 335.0, "text": "神様は言いました。"}, {"start": 339.0, "text": "「いいえ、1番はネズミですよ。"}, {"start": 343.0, "text": "今年はネズミの年です。」"}, {"start": 347.0, "text": "猫は言いました。"}, {"start": 350.0, "text": "「じゃあ、私は2番ですね。」"}, {"start": 355.0, "text": "「いいえ、みんな昨日来ましたよ。」"}, {"start": 360.0, "text": "あなたは来ませんでしたね。"}, {"start": 364.0, "text": "え？昨日ですか？"}, {"start": 368.0, "text": "猫はすぐにねずみの家へ行きました。"}, {"start": 373.0, "text": "こら、ねずみ！"}, {"start": 376.0, "text": "うわあ、猫だ！"}, {"start": 381.0, "text": "ですから、猫の年はありません。"}, {"start": 387.0, "text": "そして、今も猫はねずみが嫌いです。"}]