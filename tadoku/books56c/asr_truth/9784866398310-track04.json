[
 {
  "start": 0.0,
  "text": "東京の電車"
 },
 {
  "start": 3.0,
  "text": "作　宮城えみこ"
 },
 {
  "start": 10.0,
  "text": "東京は日本の首都です。"
 },
 {
  "start": 14.0,
  "text": "人がたくさんいます。"
 },
 {
  "start": 21.0,
  "text": "毎日たくさんの人が電車に乗ります。"
 },
 {
  "start": 26.0,
  "text": "色々な電車が走ります。"
 },
 {
  "start": 32.0,
  "text": "東京には駅が800ぐらいあります。"
 },
 {
  "start": 47.0,
  "text": "朝、5時。"
 },
 {
  "start": 49.0,
  "text": "電車の中は静かです。"
 },
 {
  "start": 54.0,
  "text": "朝、7時30分。"
 },
 {
  "start": 58.0,
  "text": "たくさんの人が駅で電車を待ちます。"
 },
 {
  "start": 66.0,
  "text": "電車が来ました。"
 },
 {
  "start": 82.0,
  "text": "たくさんの人が降ります。"
 },
 {
  "start": 85.0,
  "text": "たくさんの人が乗ります。"
 },
 {
  "start": 88.0,
  "text": "あ、エミちゃん。"
 },
 {
  "start": 92.0,
  "text": "女の人が乗ります。"
 },
 {
  "start": 97.0,
  "text": "電車の中は、とても混んでいます。"
 },
 {
  "start": 101.0,
  "text": "みんな会社へ、"
 },
 {
  "start": 103.0,
  "text": "学校へ。"
 },
 {
  "start": 115.0,
  "text": "山手線。"
 },
 {
  "start": 117.0,
  "text": "これは山手線です。"
 },
 {
  "start": 120.0,
  "text": "山手線は東京の中心を走ります。"
 },
 {
  "start": 127.0,
  "text": "山手線は11両です。"
 },
 {
  "start": 132.0,
  "text": "朝8時、1両に300人ぐらい乗ります。"
 },
 {
  "start": 138.0,
  "text": "2、3分に1本、電車が来ます。"
 },
 {
  "start": 145.0,
  "text": "昼1時、電車の中にはいろいろな人がいます。"
 },
 {
  "start": 154.0,
  "text": "ここは優先席ですよ。"
 },
 {
  "start": 162.0,
  "text": "ドアが閉まります。"
 },
 {
  "start": 169.0,
  "text": "夕方6時。"
 },
 {
  "start": 172.0,
  "text": "みんな電車で家へ帰ります。"
 },
 {
  "start": 178.0,
  "text": "どうぞ。"
 },
 {
  "start": 179.0,
  "text": "ありがとうございます。"
 },
 {
  "start": 184.0,
  "text": "夜12時。"
 },
 {
  "start": 187.0,
  "text": "東京の1日が終わります。"
 },
 {
  "start": 190.0,
  "text": "皆さん、お疲れ様でした。"
 },
 {
  "start": 206.0,
  "text": "お客さん、終点ですよ。"
 }
]