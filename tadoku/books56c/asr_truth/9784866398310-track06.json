[
 {
  "start": 0.0,
  "text": "七夕"
 },
 {
  "start": 1.0,
  "text": "織姫と彦星の話"
 },
 {
  "start": 5.0,
  "text": "再話　川名京子"
 },
 {
  "start": 12.0,
  "text": "これは夏の夜の空です。"
 },
 {
  "start": 17.0,
  "text": "天の川があります。"
 },
 {
  "start": 23.0,
  "text": "天の川の東と西に明るい星があります。"
 },
 {
  "start": 30.0,
  "text": "これは、この星のお話です。"
 },
 {
  "start": 40.0,
  "text": "昔、星の国にきれいな女の人と若い男の人がいました。"
 },
 {
  "start": 51.0,
  "text": "織姫と彦星です。"
 },
 {
  "start": 58.0,
  "text": "織姫はきれいな布を作ります。"
 },
 {
  "start": 63.0,
  "text": "毎日毎日働きます。"
 },
 {
  "start": 78.0,
  "text": "彦"
 },
 {
  "start": 80.0,
  "text": "ぼしは牛を飼います。"
 },
 {
  "start": 84.0,
  "text": "毎日、毎日、働きます。"
 },
 {
  "start": 99.0,
  "text": "ある日、彦星は天の川へ行きました。"
 },
 {
  "start": 105.0,
  "text": "織姫も天の川へ行きました。"
 },
 {
  "start": 109.0,
  "text": "そこで、二人は会いました。"
 },
 {
  "start": 115.0,
  "text": "二人は結婚しました。"
 },
 {
  "start": 119.0,
  "text": "まいに□"
 },
 {
  "start": 120.0,
  "text": "毎日、二人は一緒にいます。"
 },
 {
  "start": 123.0,
  "text": "働きませんでした。"
 },
 {
  "start": 129.0,
  "text": "牛が病気です。"
 },
 {
  "start": 133.0,
  "text": "布がありません。"
 },
 {
  "start": 136.0,
  "text": "星の国の人たちは困りました。"
 },
 {
  "start": 142.0,
  "text": "神様は怒りました。"
 },
 {
  "start": 146.0,
  "text": "織姫は天の川の西へ行きなさい。"
 },
 {
  "start": 152.0,
  "text": "彦星は東へ行きなさい。"
 },
 {
  "start": 157.0,
  "text": "そして働き"
 },
 {
  "start": 160.0,
  "text": "なさい。"
 },
 {
  "start": 164.0,
  "text": "二人は毎日働きました。"
 },
 {
  "start": 175.0,
  "text": "織姫に会いたい。"
 },
 {
  "start": 186.0,
  "text": "彦星に会いたい。"
 },
 {
  "start": 190.0,
  "text": "じゃあ、一年に一回だけ。"
 },
 {
  "start": 196.0,
  "text": "神様は、星がきれいな夜"
 },
 {
  "start": 200.0,
  "text": "鳥を呼びました。"
 },
 {
  "start": 210.0,
  "text": "鳥がたくさん来ました。"
 },
 {
  "start": 213.0,
  "text": "そして、天の川に橋を作りました。"
 },
 {
  "start": 220.0,
  "text": "織姫！"
 },
 {
  "start": 222.0,
  "text": "彦星！"
 },
 {
  "start": 227.0,
  "text": "織姫と彦星は、1年に1回、7月7日の夜に会います。"
 },
 {
  "start": 243.0,
  "text": "7月7日は"
 },
 {
  "start": 245.0,
  "text": "七夕です。"
 },
 {
  "start": 247.0,
  "text": "ささの葉 さらさら"
 },
 {
  "start": 251.0,
  "text": "のきばにゆれる"
 },
 {
  "start": 256.0,
  "text": "お星さま きらきら"
 },
 {
  "start": 260.0,
  "text": "きんぎんすなご"
 },
 {
  "start": 267.0,
  "text": "日本では"
 },
 {
  "start": 269.0,
  "text": "紙にお願いを書きます。"
 },
 {
  "start": 271.0,
  "text": "そして"
 },
 {
  "start": 273.0,
  "text": "それを笹の葉につけます。"
 }
]