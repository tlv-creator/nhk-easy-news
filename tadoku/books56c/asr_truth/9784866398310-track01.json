 },
 {
  "start": 53.0,
  "text": "「ははははは！遅くない？"
 },
 {
  "start": 58.0,
  "text": "亀さんは、とても遅いよ！」"
 },
 {
  "start": 64.0,
  "text": "亀は言いました。"
 },
 {
  "start": 67.0,
  "text": "「じゃあ、あの山の上まで走りましょう。」"
 },
 {
  "start": 75.0,
  "text": "「よーい、どん！」"
