", ""], ["取", "と"], ["れていないと", ""], ["思", "おも"], ["います", ""], ["。", ""]], "其实现在，现在我认为我自己并没有在工作和私人生活之间取得平衡。"], [[["最初", "さいしょ"], ["はバランスを", ""], ["取", "と"], ["るように", ""], ["休", "やす"], ["みを", ""], ["取", "と"], ["ろうとしていました", ""], ["。", ""]], "起初我也试着休假来保持平衡。"], [[["でも", ""], ["、", ""], ["休", "やす"], ["みの", ""], ["日", "ひ"], ["に", ""], ["時", "じ"], ["間", "かん"], ["があると", ""], ["、", ""], ["いつも", ""], ["仕", "し"], ["事", "ごと"], ["をしてしまっていました", ""], ["。", ""]], "但是，休息日只要有时间，我总会不知不觉就去工作了。"], [[["でも", ""], ["、", ""], ["この", ""], ["時", "とき"], ["、", ""], ["気", "き"], ["づきました", ""], ["。", ""]], "但是，这时我意识到了。"], [[["多分", "たぶん"], ["、", ""], ["仕", "し"], ["事", "ごと"], ["が", ""], ["本", "ほん"], ["当", "とう"], ["に", ""], ["好", "す"], ["きだと", ""], ["気", "き"], ["づきました", ""], ["。", ""]], "我意识到，大概自己是真的喜欢工作。"], [[["今", "いま"], ["の", ""], ["仕", "し"], ["事", "ごと"], ["が", ""], ["好", "す"], ["きだから", ""], ["、", ""], ["毎日", "まいにち"], ["時", "じ"], ["間", "かん"], ["があると", ""], ["、", ""], ["仕", "し"], ["事", "ごと"], ["をしているんだと", ""], ["気", "き"], ["づきました", ""], ["。", ""]], "因为喜欢现在的工作，所以我意识到，只要每天有时间，自己其实就在做着工作。"], [[["でも", ""], ["、", ""], ["そうですよね", ""], ["。", ""]], "不过也是呢。"], [[["私", "わたし"], ["はフリーランスなので", ""], ["、", ""], ["仕", "し"], ["事", "ごと"], ["をしなくてもいいです", ""], ["。", ""]], "因为我是自由职业，所以不工作也是可以的。"], [[["時", "じ"], ["間", "かん"], ["がある", ""], ["時", "とき"], ["は", ""], ["、", ""], ["映", "えい"], ["画", "が"], ["を", ""], ["見", "み"], ["たり", ""], ["、", ""], ["ごロゴロしてもいいのに", ""], ["、", ""], ["仕", "し"], ["事", "ごと"], ["をしていますから", ""], ["、", ""], ["本", "ほん"], ["当", "とう"], ["にハマっているんだと", ""], ["思", "おも"], ["いました", ""], ["。", ""]], "有时间的时候，明明去看看电影、闲躺着无所事事也是可以的，但我却在工作，所以我心想自己是真的入迷了。"], [[["だから", ""], ["、", ""], ["多分", "たぶん"], ["他", "た"], ["の", ""], ["人", "ひと"], ["から", ""], ["見", "み"], ["ると", ""], ["、", ""], ["ワークホリックみたいで", ""], ["心", "しん"], ["配", "くば"], ["されます", ""], ["。", ""]], "所以，在别人看来可能像个工作狂一样，会被别人担心。"], [[["家", "か"], ["族", "ぞく"], ["や", ""], ["妻", "つま"], ["や", ""], ["友", "とも"], ["達", "だち"], ["にも", ""], ["心", "しん"], ["配", "くば"], ["されました", "