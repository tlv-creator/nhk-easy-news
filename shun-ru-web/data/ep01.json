["毎日", "まいにち"], ["会", "あ"], ["うから", ""], ["少", "すこ"], ["しずつ", ""], ["中", "なか"], ["が", ""], ["良", "よ"], ["くなって", ""], ["一緒", "いっしょ"], ["に", ""], ["晩", "ばん"], ["御", "ご"], ["飯", "はん"], ["を", ""], ["食", "た"], ["べたりパーティに", ""], ["行", "い"], ["ったりしました", ""]], "每天都见面，慢慢就熟悉起来，还会一起吃晚饭、去参加派对。"], [[["あとはあの", ""], ["旅", "りょ"], ["行", "こう"], ["に", ""], ["行", "い"], ["った", ""], ["時", "とき"], ["のホステルでたくさん", ""], ["友", "とも"], ["達", "だち"], ["を", ""], ["作", "つく"], ["りました", ""]], "还有就是旅行的时候，在青年旅舍交了很多朋友。"], [[["ホステルでほとんど", ""], ["友", "とも"], ["達", "だち"], ["を", ""], ["作", "つく"], ["りましたね", ""]], "我的朋友基本上都是在青年旅舍认识的。"], [[["時", "ときどき"], ["々", ""], ["ホステルで", ""], ["会", "あ"], ["った", ""], ["人", "ひ"], ["と", ""], ["一緒", "いっしょ"], ["に", ""], ["旅", "りょ"], ["行", "こう"], ["に", ""], ["行", "い"], ["って", ""], ["今", "いま"], ["でも", ""], ["連絡", "れんらく"], ["をとてます", ""], ["時", "ときどき"], ["々", ""], ["彼", "かれ"], ["らに", ""], ["会", "あ"], ["いに", ""], ["行", "い"], ["きましたよ", ""], ["。", ""]], "偶尔会和在旅舍认识的人一起去旅行，现在也还一直联系着，"], [[["はい", ""], ["、", ""], ["まあ", ""], ["本", "ほん"], ["当", "とう"], ["に", ""], ["楽", "たの"], ["しい", ""], ["時", "じ"], ["間", "かん"], ["でした", ""], ["。", ""]], "嗯，真的是非常快乐的时光。"], [[["ホステルは", ""], ["本", "ほん"], ["当", "とう"], ["にたくさん", ""], ["新", "あたら"], ["しい", ""], ["友", "とも"], ["達", "だち"], ["を", ""], ["作", "つく"], ["ることができるいい", ""], ["場所", "ばしょ"], ["だと", ""], ["思", "おも"], ["いますね", ""], ["。", ""]], "我觉得青年旅舍是能交到很多新朋友的好地方。"], [[["本", "ほん"], ["当", "とう"], ["に", ""], ["仲", "なか"], ["がいい", ""], ["最高", "さいこう"], ["の", ""], ["友", "とも"], ["達", "だち"], ["を", ""], ["見", "み"], ["つけることができて", ""], ["嬉", "うれ"], ["しいです", ""], ["。", ""]], "能找到关系最好的朋友，我很高兴。"], [[["新", "あたら"], ["しい", ""], ["友", "とも"], ["達", "だち"], ["は", ""], ["自分", "じぶん"], ["と", ""], ["価値", "かち"], ["観", "かん"], ["が", ""], ["同", "おな"], ["じ", ""], ["人", "ひと"], ["が", ""], ["多", "おお"], ["いと", ""], ["思", "おも"], ["います", ""], ["。", ""]], "我觉得新朋友大多价值观和自己一样的人比较多。"], [[["幼", "おさ"], ["なじみは", ""], ["色", "いろいろ"], ["々", ""], ["な", ""], ["価値", "かち"], ["観", "かん"], ["の", ""], ["人", "ひと"], ["がいま